@page "/League"
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@inject IJSRuntime JSRuntime

<h3>リーグ戦</h3>
<div class="container mt-4">

    <div class="mb-4">
        <div class="btn-group" role="group">
            <button type="button" class="btn @(!isDoublesMode ? "btn-dark fw-bold" : "btn-outline-dark")" @onclick="() => ChangeMode(false)">
                <i class="bi bi-person-fill"></i> シングルス戦
            </button>
            <button type="button" class="btn @(isDoublesMode ? "btn-dark fw-bold" : "btn-outline-dark")" @onclick="() => ChangeMode(true)">
                <i class="bi bi-people-fill"></i> ダブルス戦
            </button>
        </div>
    </div>

    <div class="card mb-4 border-primary">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">
                <i class="bi bi-person-plus"></i> 参加メンバー登録
            </h5>
            <span class="badge bg-white text-primary fw-bold fs-6">
                現在: @players.Count 人
            </span>
        </div>
        <div class="card-body">
            <div class="input-group mb-3">
                <input @ref="playerNameInput" autofocus type="text" class="form-control"
                       placeholder="プレイヤーを入力（例: 佐藤）" @bind="newPlayerName" @onkeyup="HandleKeyUp" />
                <button class="btn btn-primary" type="button" @onclick="AddPlayer">追加</button>
            </div>

            @if (players.Any())
            {
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var player in players)
                    {
                        <span class="badge bg-secondary d-flex align-items-center p-2">
                            @player
                            <button type="button" class="btn-close btn-close-white ms-2" style="font-size: 0.5rem;" @onclick="() => RemovePlayer(player)"></button>
                        </span>
                    }
                </div>
            }
        </div>
    </div>

    @if (isDoublesMode)
    {
        <div class="card mb-4 border-info">
            <div class="card-header bg-info text-white">
                <h5 class="card-title mb-0"><i class="bi bi-link-45deg"></i> ダブルスペアの作成</h5>
            </div>
            <div class="card-body">
                <div class="row g-2 align-items-center">
                    <div class="col-sm-4">
                        <select class="form-select" @bind="pairSelect1">
                            <option value="">-- 1人目を選択 --</option>
                            @foreach (var p in players)
                            {
                                <option value="@p">@p</option>
                            }
                        </select>
                    </div>
                    <div class="col-auto">と</div>
                    <div class="col-sm-4">
                        <select class="form-select" @bind="pairSelect2">
                            <option value="">-- 2人目を選択 --</option>
                            @foreach (var p in players)
                            {
                                <option value="@p">@p</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-3">
                        <button class="btn btn-info text-white w-100" @onclick="AddPair">ペアを登録</button>
                    </div>
                </div>

                <div class="mt-3 d-flex gap-2">
                    <button class="btn btn-outline-info btn-sm" type="button" @onclick="GenerateRandomPairs">
                        <i class="bi bi-shuffle"></i> ランダムにペアを生成
                    </button>
                    @if (doublesPairs.Any())
                    {
                        <button class="btn btn-outline-danger btn-sm" type="button" @onclick="ClearAllPairs">
                            <i class="bi bi-trash"></i> ペアをすべてクリア
                        </button>
                    }
                </div>

                @if (doublesPairs.Any())
                {
                    <div class="d-flex flex-wrap gap-2 mt-3">
                        @foreach (var pair in doublesPairs)
                        {
                            <span class="badge bg-info text-white d-flex align-items-center p-2">
                                @pair
                                <button type="button" class="btn-close btn-close-white ms-2" style="font-size: 0.5rem;" @onclick="() => RemovePair(pair)"></button>
                            </span>
                        }
                    </div>
                }
                @if (!string.IsNullOrEmpty(alertMessage))
                {
                    <div class="alert alert-warning mt-3 mb-0 d-flex align-items-center gap-2 animate__animated animate__fadeIn">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <div>@alertMessage</div>
                    </div>
                }
            </div>
        </div>
    }

    @if ((!isDoublesMode && players.Count >= 2) || (isDoublesMode && doublesPairs.Count >= 2))
    {
        <div class="mb-4 d-flex gap-2">
            <button class="btn btn-success flex-grow-1 fw-bold p-2" @onclick="GenerateLeague">
                <i class="bi bi-play-fill"></i> @(isDoublesMode ? "ダブルス" : "シングルス") リーグ表を生成
            </button>
            <button class="btn btn-outline-danger" @onclick="ClearCurrentLeague">表をリセット</button>
        </div>
    }

    @if (CurrentMatches != null && CurrentMatches.Any())
    {
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">@(isDoublesMode ? "ダブルス リーグ戦対戦表" : "シングルス リーグ戦対戦表")</h5>
                <div class="table-responsive">
                    <table class="table table-bordered text-center align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>名前</th>
                                @foreach (var p in CurrentTargetList)
                                {
                                    <th>@p</th>
                                }
                                <th class="table-info">勝敗</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p1 in CurrentTargetList)
                            {
                                <tr>
                                    <th class="table-light">@p1</th>
                                    @foreach (var p2 in CurrentTargetList)
                                    {
                                        if (p1 == p2)
                                        {
                                            <td class="table-secondary">---</td>
                                        }
                                        else
                                        {
                                            var match = GetMatch(p1, p2);
                                            <td>
                                                @if (match != null)
                                                {
                                                    <div class="d-flex justify-content-center align-items-center gap-1">
                                                        <input type="number" class="form-control form-control-sm text-center"
                                                               style="width: 50px;"
                                                               value="@(match.Player1 == p1 ? match.Score1 : match.Score2)"
                                                               @onchange="(e) => UpdateScore(match, p1, e.Value)" />
                                                        <span>-</span>
                                                        <input type="number" class="form-control form-control-sm text-center"
                                                               style="width: 50px;"
                                                               value="@(match.Player1 == p1 ? match.Score2 : match.Score1)"
                                                               @onchange="(e) => UpdateScore(match, p2, e.Value)" />
                                                    </div>
                                                    <div class="small mt-1 text-muted">
                                                        @GetMatchResultText(match, p1)
                                                    </div>
                                                }
                                            </td>
                                        }
                                    }
                                    <td class="table-info fw-bold">
                                        @GetStats(p1).wins 勝 - @GetStats(p1).losses 敗
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <button class="btn btn-info text-white mb-4" @onclick="CalculateRanking">
            <i class="bi bi-trophy-fill"></i> 結果発表
        </button>
    }

    @if (rankings != null && rankings.Any())
    {
        <div class="card mb-4 border-success animate__animated animate__fadeIn">
            <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0"><i class="bi bi-award"></i> 最終順位結果</h5>
                <button type="button" class="btn-close btn-close-white" @onclick="() => rankings.Clear()"></button>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover text-center align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th style="width: 20%;">順位</th>
                                <th>名前</th>
                                <th>勝数</th>
                                <th>敗数</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int rank = 1;
                            }
                            @foreach (var r in rankings)
                            {
                                <tr class="@(rank == 1 ? "table-warning fw-bold" : "")">
                                    <td>
                                        @if (rank == 1)
                                        {
                                            <span>🥇 1位</span>
                                        }
                                        else if (rank == 2)
                                        {

                                            <span>🥈 2位</span>
                                        }
                                        else if (rank == 3)
                                        {

                                            <span>🥉 3位</span>
                                        }
                                        else
                                        {

                                            <span>@rank 位</span>
                                        }
                                    </td>
                                    <td>@r.PlayerName</td>
                                    <td class="text-success fw-bold">@r.Wins</td>
                                    <td class="text-danger">@r.Losses</td>
                                </tr>
                                rank++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool isDoublesMode = false;
    // ★追加：お知らせメッセージを保持する変数
    private string alertMessage = "";

    // データ保持用変数
    private List<string> players = new();          // ★常に共通のプレイヤー名リスト
    private List<string> doublesPairs = new();     // ダブルスのペア名リスト (例: "佐藤・鈴木")

    private List<MatchResult> singlesMatches = new(); // シングルス用の試合データ
    private List<MatchResult> doublesMatches = new(); // ダブルス用の試合データ

    private List<PlayerRank> rankings = new();
    private ElementReference playerNameInput;

    private string newPlayerName = "";
    private string pairSelect1 = "";
    private string pairSelect2 = "";

    // モードに応じて、参照する「対戦相手リスト」と「試合データ」を切り替えるプロパティ
    private List<string> CurrentTargetList => isDoublesMode ? doublesPairs : players;
    private List<MatchResult> CurrentMatches => isDoublesMode ? doublesMatches : singlesMatches;

    // ★追加：手動で登録された固定ペアだけを保持するリスト
    private List<string> fixedPairs = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // プレイヤー一覧（共通）の復元
            var savedPlayers = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "tennis_common_players");
            if (!string.IsNullOrEmpty(savedPlayers)) players = JsonSerializer.Deserialize<List<string>>(savedPlayers) ?? new();

            // ダブルスペア一覧の復元
            var savedPairs = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "tennis_doubles_pairs");
            if (!string.IsNullOrEmpty(savedPairs)) doublesPairs = JsonSerializer.Deserialize<List<string>>(savedPairs) ?? new();

            // 各試合データの復元
            var savedSMatches = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "tennis_singles_matches");
            if (!string.IsNullOrEmpty(savedSMatches)) singlesMatches = JsonSerializer.Deserialize<List<MatchResult>>(savedSMatches) ?? new();

            var savedDMatches = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "tennis_doubles_matches");
            if (!string.IsNullOrEmpty(savedDMatches)) doublesMatches = JsonSerializer.Deserialize<List<MatchResult>>(savedDMatches) ?? new();
            var doublesPairsJson = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "doublesPairs");
            if (!string.IsNullOrEmpty(doublesPairsJson))
            {
                doublesPairs = JsonSerializer.Deserialize<List<string>>(doublesPairsJson) ?? new();
            }

            // ★追加：手動登録の固定ペアをローカルストレージから読み込む
            var fixedPairsJson = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "fixedPairs");
            if (!string.IsNullOrEmpty(fixedPairsJson))
            {
                fixedPairs = JsonSerializer.Deserialize<List<string>>(fixedPairsJson) ?? new();
            }
            else
            {
                // 万が一 fixedPairs のデータがストレージにない（初回など）場合は、
                // 既存の doublesPairs の中身をそのまま fixedPairs として復元させておくと安全です
                fixedPairs = new List<string>(doublesPairs);

            }
        }
        catch { }
    }

    private async Task SaveToLocalStorage()
    {
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "tennis_common_players", JsonSerializer.Serialize(players));
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "tennis_doubles_pairs", JsonSerializer.Serialize(doublesPairs));
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "tennis_singles_matches", JsonSerializer.Serialize(singlesMatches));
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "tennis_doubles_matches", JsonSerializer.Serialize(doublesMatches));
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "fixedPairs", JsonSerializer.Serialize(fixedPairs));
    }

    private void ChangeMode(bool doublesMode)
    {
        isDoublesMode = doublesMode;
        rankings.Clear(); // 順位表示は一度クリア
    }

    private async Task AddPlayer()
    {
        var name = newPlayerName?.Trim();

        // 1. 空白チェック
        if (string.IsNullOrEmpty(name))
        {
            await JSRuntime.InvokeVoidAsync("alert", "名前を入力してください。");
            await playerNameInput.FocusAsync();
            return;
        }

        // 2. 重複チェック（p.Name ではなく、p 自体が名前の文字列）
        if (players.Any(p => p == name)) // 👈 ここを修正！(または players.Contains(name) でもOK)
        {
            await JSRuntime.InvokeVoidAsync("alert", "同じ名前のプレイヤーがいます。");
            newPlayerName = "";
            await playerNameInput.FocusAsync();
            return;
        }

        // 3. どちらのチェックも通過したらリストに追加して保存
        players.Add(name);

        newPlayerName = "";
        await SaveToLocalStorage();
        await playerNameInput.FocusAsync();
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddPlayer();
    }

    private async Task RemovePlayer(string player)
    {
        players.Remove(player);
        // プレイヤーが削除されたら関連するペアや試合もリセット
        doublesPairs.RemoveAll(p => p.Contains(player));
        singlesMatches.Clear();
        doublesMatches.Clear();
        rankings.Clear();
        await SaveToLocalStorage();
    }

    // ダブルスのペアを作成・追加
    private async Task AddPair()
    {
        // どちらもまだ誰とも組んでいなければ登録
        string pairName = $"{pairSelect1} & {pairSelect2}";
        string reversePairName = $"{pairSelect2} & {pairSelect1}";

        if (string.IsNullOrEmpty(pairSelect1) || string.IsNullOrEmpty(pairSelect2)) return;

        //追加】同じ人が選ばれていないかチェック
        if (pairSelect1 == pairSelect2)
        {
            await JSRuntime.InvokeVoidAsync("alert", "同じ人が組まれています。");
            return;
        }


        // 二人がすでに全く同じ組み合わせでペアを組んでいるかチェック
        if (fixedPairs.Contains(pairName) || fixedPairs.Contains(reversePairName))
        {
            await JSRuntime.InvokeVoidAsync("alert", "二人はすでにペアです。");
            return;
        }

        //  選択されたプレイヤー1が、すでに他のペアに含まれていないかチェック
        // (例: fixedPairs の中に "A & " または " & A" という形で存在するか)
        bool isPlayer1Registered = fixedPairs.Any(p => p.Split(" & ").Contains(pairSelect1));
        if (isPlayer1Registered)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"{pairSelect1}さんはペアが決まっています。");
            return;
        }

        // 選択されたプレイヤー2が、すでに他のペアに含まれていないかチェック
        bool isPlayer2Registered = fixedPairs.Any(p => p.Split(" & ").Contains(pairSelect2));
        if (isPlayer2Registered)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"{pairSelect2}さんはペアが決まっています。");
            return;
        }

        fixedPairs.Add(pairName);
        doublesPairs.Add(pairName);

        // フォームをリセット
        pairSelect1 = "";
        pairSelect2 = "";
        await SaveToLocalStorage();
    }

    // ★ここに追加：ランダム自動ペア生成ロジック
    // ★変更：既存のペアは残し、未登録のメンバーだけでランダムペアを作る
    private async Task GenerateRandomPairs()
    {
        // 毎回メッセージをリセット
        alertMessage = "";

        // ★重要：一度すべてのペアを「手動登録されたペア」だけの状態に戻す（＝ランダムペアをクリア）
        doublesPairs = new List<string>(fixedPairs);

        // 1. すでに登録されているペアに含まれているプレイヤーを抽出
        var registeredPlayers = fixedPairs
            .SelectMany(p => p.Split(" & "))
            .ToHashSet();

        // 2. まだどのペアにも属していない「残りのプレイヤー」をリストアップ
        var remainingPlayers = players
            .Where(p => !registeredPlayers.Contains(p))
            .ToList();

        // 残りの人数が2人未満ならペアを作れない
        if (remainingPlayers.Count < 2)
        {
            if (remainingPlayers.Count == 1)
            {
                alertMessage = $"ペアが作成できないため、{remainingPlayers[0]}さんがお休みとなります。";
            }
            await SaveToLocalStorage();
            return;
        }

        // 3. 残ったプレイヤーのリストをランダムにシャッフル
        var rand = new Random();
        var shuffledRemaining = remainingPlayers.OrderBy(_ => rand.Next()).ToList();

        // ★変更：奇数の場合、最後の1人を除外してお知らせに載せる（処理は止めずに続行！）
        if (shuffledRemaining.Count % 2 != 0)
        {
            string excludedPlayer = shuffledRemaining.Last();
            shuffledRemaining.RemoveAt(shuffledRemaining.Count - 1);

            alertMessage = $"メンバーが奇数だったため、{excludedPlayer}さんはお休みとなります。";
        }

        // 4. シャッフルしたメンバーから2人ずつペアを作って追加
        for (int i = 0; i < shuffledRemaining.Count - 1; i += 2)
        {
            string p1 = shuffledRemaining[i];
            string p2 = shuffledRemaining[i + 1];

            string pairName = $"{p1} & {p2}";
            doublesPairs.Add(pairName);
        }

        // メンバー構成が変わったので、古い試合表とランキングは一度クリア
        doublesMatches.Clear();
        rankings.Clear();

        await SaveToLocalStorage();
    }

    // ★変更：一括クリアしたときはメッセージも消す
    private async Task ClearAllPairs()
    {
        doublesPairs.Clear();
        fixedPairs.Clear(); // 手動登録ペアもクリア
        doublesMatches.Clear();
        rankings.Clear();
        alertMessage = ""; // メッセージも消す
        await SaveToLocalStorage();
    }

    // ★変更：手動でペアを消したときもメッセージをリセット
    private async Task RemovePair(string pair)
    {
        doublesPairs.Remove(pair);
        doublesMatches.Clear();
        rankings.Clear();
        alertMessage = ""; // メッセージも消す
        await SaveToLocalStorage();
    }


    // 表示中のリーグ表のみを初期化する（メンバーは消さない）
    private async Task ClearCurrentLeague()
    {
        if (isDoublesMode) doublesMatches.Clear();
        else singlesMatches.Clear();
        rankings.Clear();
        await SaveToLocalStorage();
    }

    private async Task GenerateLeague()
    {
        CurrentMatches.Clear();
        rankings.Clear();

        var targetList = CurrentTargetList;
        for (int i = 0; i < targetList.Count; i++)
        {
            for (int j = i + 1; j < targetList.Count; j++)
            {
                CurrentMatches.Add(new MatchResult { Player1 = targetList[i], Player2 = targetList[j] });
            }
        }
        await SaveToLocalStorage();
    }

    //同じ組み合わせの対戦相手を見つけ出すメゾット。佐藤vs鈴木もしくは鈴木vs佐藤のどちらでもマッチするようにする。
    private MatchResult GetMatch(string p1, string p2)
    {
        return CurrentMatches.FirstOrDefault(m =>
            (m.Player1 == p1 && m.Player2 == p2) || (m.Player1 == p2 && m.Player2 == p1));
    }

    private async Task UpdateScore(MatchResult match, string player, object value)
    {
        if (int.TryParse(value?.ToString(), out int score))
        {
            if (match.Player1 == player) match.Score1 = score;
            else match.Score2 = score;

            match.IsPlayed = true;
            await SaveToLocalStorage();
            StateHasChanged();
        }
    }

    private string GetMatchResultText(MatchResult match, string currentPlayer)
    {
        if (!match.IsPlayed) return "";
        bool isP1 = match.Player1 == currentPlayer;
        int myScore = isP1 ? match.Score1 : match.Score2;
        int opScore = isP1 ? match.Score2 : match.Score1;

        if (myScore > opScore) return "◯";
        if (myScore < opScore) return "✖";
        return "△";
    }

    private void CalculateRanking()
    {
        rankings.Clear();
        foreach (var target in CurrentTargetList)
        {
            var (wins, losses) = GetStats(target);
            rankings.Add(new PlayerRank { PlayerName = target, Wins = wins, Losses = losses });
        }
        rankings = rankings.OrderByDescending(r => r.Wins).ThenBy(r => r.Losses).ToList();
    }

    private (int wins, int losses) GetStats(string target)
    {
        int wins = 0; int losses = 0;
        foreach (var m in CurrentMatches)
        {
            if (!m.IsPlayed) continue;
            if (m.Player1 == target) { if (m.Score1 > m.Score2) wins++; else if (m.Score1 < m.Score2) losses++; }
            else if (m.Player2 == target) { if (m.Score2 > m.Score1) wins++; else if (m.Score2 < m.Score1) losses++; }
        }
        return (wins, losses);
    }

    public class PlayerRank
    {
        public string PlayerName { get; set; } = "";
        public int Wins { get; set; }
        public int Losses { get; set; }
    }
    public class MatchResult
    {
        public string Player1 { get; set; } = "";
        public string Player2 { get; set; } = "";
        public int Score1 { get; set; }
        public int Score2 { get; set; }
        public bool IsPlayed { get; set; }
    }
}
